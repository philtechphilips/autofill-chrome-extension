{
  "manifest_version": 3,
  "name": "Autofill.Ai",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Open Autofill.AI popup"
    },
    "execute-autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Execute Autofill on current page"
    },
    "undo-fill": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "MacCtrl+Shift+Z"
      },
      "description": "Undo last autofill"
    }
  }
}
